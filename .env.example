# SalonBook client — public configuration only. No secrets belong here.
# The Express server's base URL (local development). Auth calls from the
# browser do NOT use this directly: they go to the client origin and
# Next.js rewrites /api/* to this URL, so the server URL never appears
# in the browser during auth (examiner feedback, Assignment 9).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Client origin, used only as a server-render fallback for the auth
# client baseURL (the browser always uses window.location.origin).
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
